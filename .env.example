# Telegram
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
TELEGRAM_SOURCE_CHANNEL_ID=-1001234567890
TELEGRAM_REPORT_CHAT_ID=-1009876543210

# PostgreSQL
POSTGRES_DB=weeklyreport
POSTGRES_USER=weeklyreport
POSTGRES_PASSWORD=change-me
# Порт на хосте, на котором Postgres из docker-compose будет доступен снаружи контейнера
# (например, для backend, запущенного локально из IDE). Не 5432 по умолчанию, чтобы не
# конфликтовать с локально установленным PostgreSQL.
POSTGRES_PORT=6868

# Расписание недельного отчёта (необязательно - есть значения по умолчанию)
WEEKLY_REPORT_CRON=0 0 9 * * MON
WEEKLY_REPORT_TIMEZONE=Asia/Almaty
